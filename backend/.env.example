# ============================================================
# Zoom Bot Meeting Recorder Suite — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values

PORT=3000
NODE_ENV=production
API_HOST=0.0.0.0

# --- JWT Authentication & Admin User ---
JWT_SECRET=change_me_to_a_random_secret_key
ADMIN_EMAIL=admin@zoom.com
ADMIN_PASSWORD=change_me_to_a_secure_password
ENCRYPTION_KEY=change_me_to_64_char_hex_string

# --- Zoom SDK & OAuth Credentials ---
ZOOM_SDK_KEY=your-zoom-sdk-key
ZOOM_SDK_SECRET=your-zoom-sdk-secret
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
ZOOM_REDIRECT_URI=https://zoom-ai-participent.onrender.com/oauth/zoom/callback
ZOOM_BOT_DISPLAY_NAME=AI Meeting Recorder

# --- Zoom Server-to-Server / Cloud Recording (Optional) ---
ZOOM_ACCOUNT_ID=
ZOOM_WEBHOOK_SECRET_TOKEN=

# --- Telegram Bot Integration ---
# Create a bot via @BotFather on Telegram and paste the token here.
# Recordings will be auto-uploaded to Telegram after capture.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
ADMIN_CHAT_IDS=your-telegram-chat-id
AUTHORIZED_TELEGRAM_IDS=

# --- Google Drive Cloud Sync (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://zoom-ai-participent.onrender.com/api/drive/callback

# --- Storage & Directories ---
RECORDINGS_DIR=./recordings

# --- Browser Automation Settings ---
# In cloud/Docker, Playwright auto-detects the browser path.
# Only set CHROME_PATH when running locally on Windows/macOS.
PLAYWRIGHT_HEADLESS=true
# CHROME_PATH=C:\Users\youruser\AppData\Local\ms-playwright\chromium-1234\chrome-win64\chrome.exe

# --- Cloud Deployment ---
# Set to 'true' when running on Render/Railway/cloud (disables native Zoom desktop mode)
CLOUD_MODE=true
