# ── Server & Environment ──────────────────────────────────────────────
APP_ENV=development
PORT=3000
HOST=http://localhost:3000

# ── Telegram Control Plane ────────────────────────────────────────────
# Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of allowed Telegram user IDs or usernames (empty = allow all)
TELEGRAM_ALLOWED_USERS=

# ── Zoom SDK & OAuth Credentials ──────────────────────────────────────
# From Zoom App Marketplace (Meeting SDK App)
ZOOM_CLIENT_ID=your_zoom_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_client_secret_here
ZOOM_SDK_KEY=your_zoom_sdk_key_here
ZOOM_SDK_SECRET=your_zoom_sdk_secret_here
ZOOM_REDIRECT_URI=http://localhost:3000/oauth/zoom/callback

# Bot account Zoom user ID or email (for ZAK retrieval)
ZOOM_BOT_USER_ID=me
ZOOM_BOT_DISPLAY_NAME=Meeting Recorder Bot

# ── Database & Storage ────────────────────────────────────────────────
# SQLite database path
DATABASE_PATH=./data/zoomrecord.sqlite
# Local storage directory for recordings
RECORDINGS_DIR=./recordings

# ── Firebase Admin SDK (Optional / Mobile App Integration) ────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
